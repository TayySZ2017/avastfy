{
  "name": "avastfy-ios",
  "version": "1.0.0",
  "description": "Avastfy für iPhone (iOS .ipa) – Liquid Glass Music Player mit Adaptive Vibe, Unzensierter Suche, LRCLIB Lyrics, 10-Band EQ & Spotify Import",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:assets": "node scripts/generate-ios-assets.mjs",
    "build": "npm run build:assets && vite build",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/patch-ios-plist.mjs",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
